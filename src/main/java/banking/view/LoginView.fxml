<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.controller.LoginController"
            prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #f5f5f5;">

    <!-- Top Section - Header -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 25;">
            <Label text="Banking System Login" textFill="white">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label text="Please enter your credentials" textFill="#ecf0f1">
                <font>
                    <Font size="13.0" />
                </font>
                <VBox.margin>
                    <Insets top="8.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- Center Section - Login Form -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 40;">

            <!-- Login Form -->
            <GridPane hgap="15.0" vgap="15.0" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="120.0" />
                    <ColumnConstraints minWidth="200.0" prefWidth="250.0" />
                </columnConstraints>

                <!-- User ID Field -->
                <Label text="User ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;">
                </Label>
                <TextField fx:id="txtUserId" promptText="Enter customer ID or admin username"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-font-size: 13px;">
                </TextField>

                <!-- Password Field -->
                <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;">
                </Label>
                <PasswordField fx:id="txtPassword" promptText="Enter password"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-font-size: 13px;">
                </PasswordField>
            </GridPane>

            <!-- Status Label -->
            <Label fx:id="lblStatus" text="" textFill="#e74c3c" wrapText="true"
                   textAlignment="CENTER" maxWidth="400.0">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>

            <!-- Button Container -->
            <HBox spacing="15.0" alignment="CENTER">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>

                <!-- Customer Login Button -->
                <Button text="Customer Login" onAction="#handleCustomerLogin"
                        prefWidth="150.0" prefHeight="45.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5;">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <!-- Staff Login Button -->
                <Button text="Staff Login" onAction="#handleStaffLogin"
                        prefWidth="150.0" prefHeight="45.0"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5;">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </HBox>

            <!-- Separator -->
            <Separator prefWidth="400.0">
                <VBox.margin>
                    <Insets top="10.0" bottom="10.0" />
                </VBox.margin>
            </Separator>

            <!-- Quick Account Creation -->
            <VBox spacing="10.0" alignment="CENTER">
                <Label text="New User? Quick Account Creation"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;">
                </Label>

                <Label text="Enter a new customer ID above, then click the button below"
                       textFill="#7f8c8d" style="-fx-font-size: 11px;">
                </Label>

                <Button text="Create Account (Quick)" onAction="#handleOpenAccount"
                        prefWidth="200.0" prefHeight="40.0"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 5;">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Section - Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 12;">
            <Label text="Default Admin: admin / admin123 | Quick accounts use password: 1234"
                   textFill="#7f8c8d">
                <font>
                    <Font size="10.0" />
                </font>
            </Label>
        </HBox>
    </bottom>
</BorderPane>