<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.controller.WelcomeController"
            prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f5f5f5;">

    <!-- Top Section - Header -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 30;">
            <Label text="Student Banking System" textFill="white">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>
            <Label text="Secure • Reliable • Easy to Use" textFill="#ecf0f1">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- Center Section - Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 40;">
            <Label text="Welcome! Please select an option:" style="-fx-font-size: 18px; -fx-text-fill: #34495e;">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>

            <!-- Customer Login Button -->
            <Button text="Customer Login" onAction="#handleCustomerLogin"
                    prefWidth="300.0" prefHeight="50.0"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 5;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>

            <!-- Admin Login Button -->
            <Button text="Admin Login" onAction="#handleAdminLogin"
                    prefWidth="300.0" prefHeight="50.0"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 5;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>

            <!-- Separator -->
            <Separator prefWidth="300.0">
                <VBox.margin>
                    <Insets top="10.0" bottom="10.0" />
                </VBox.margin>
            </Separator>

            <!-- Open New Account Button -->
            <Button text="Open New Account" onAction="#handleOpenAccount"
                    prefWidth="300.0" prefHeight="50.0"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 5;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>

            <!-- Info Label -->
            <Label text="New to our bank? Click 'Open New Account' to get started!"
                   textFill="#7f8c8d" wrapText="true" textAlignment="CENTER" maxWidth="300.0">
                <font>
                    <Font size="12.0" />
                </font>
                <VBox.margin>
                    <Insets top="20.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </center>

    <!-- Bottom Section - Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Label text="© 2024 Student Banking System | Secure Banking for Students" textFill="#7f8c8d">
                <font>
                    <Font size="11.0" />
                </font>
            </Label>
        </HBox>
    </bottom>
</BorderPane>