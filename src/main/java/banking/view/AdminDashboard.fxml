<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.controller.AdminDashboardController"
            prefHeight="600.0" prefWidth="900.0">

    <!-- Top Section - Header -->
    <top>
        <VBox style="-fx-background-color: #e74c3c; -fx-padding: 20;">
            <Label text="Admin Dashboard" textFill="white">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label text="System Administration and Management" textFill="#ecf0f1">
                <font>
                    <Font size="13.0" />
                </font>
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- Center Section - Main Content -->
    <center>
        <SplitPane dividerPositions="0.75" prefHeight="400.0" prefWidth="600.0">

            <!-- Left Side - Display Area -->
            <AnchorPane minWidth="500.0">
                <TextArea fx:id="txtArea" editable="false" wrapText="true"
                          style="-fx-font-family: 'Courier New'; -fx-font-size: 13px;"
                          AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0"
                          AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"/>
            </AnchorPane>

            <!-- Right Side - Admin Actions -->
            <AnchorPane minWidth="200.0" style="-fx-background-color: #ecf0f1;">
                <VBox spacing="15.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="15.0"
                      AnchorPane.rightAnchor="15.0">

                    <Label text="Admin Functions" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;">
                        <VBox.margin>
                            <Insets bottom="10.0" />
                        </VBox.margin>
                    </Label>

                    <Button text="List All Customers" onAction="#listAllCustomers"
                            prefWidth="170.0" prefHeight="40.0"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 3;">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Button>

                    <Button text="Apply Interest" onAction="#applyInterest"
                            prefWidth="170.0" prefHeight="40.0"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 3;">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Button>

                    <Button text="Create Admin Account" onAction="#createAdminAccount"
                            prefWidth="170.0" prefHeight="40.0"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 3;">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Button>

                    <Separator prefWidth="170.0">
                        <VBox.margin>
                            <Insets top="20.0" bottom="5.0" />
                        </VBox.margin>
                    </Separator>

                    <Label text="System Info" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="170.0">
                        <VBox.margin>
                            <Insets top="10.0" bottom="10.0" />
                        </VBox.margin>
                    </Label>

                    <Button text="Logout" onAction="#logout"
                            prefWidth="170.0" prefHeight="40.0"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 3;">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                        <VBox.margin>
                            <Insets top="20.0" />
                        </VBox.margin>
                    </Button>
                </VBox>
            </AnchorPane>
        </SplitPane>
    </center>

    <!-- Bottom Section - Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #c0392b; -fx-padding: 10;">
            <Label text="Admin Portal | Authorized Access Only" textFill="white">
                <font>
                    <Font name="System Bold" size="11.0" />
                </font>
            </Label>
        </HBox>
    </bottom>
</BorderPane>