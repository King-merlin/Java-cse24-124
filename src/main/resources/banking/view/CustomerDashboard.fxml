<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.controller.CustomerDashboardController"
            prefWidth="700"
            prefHeight="500">

    <!-- Top: Title Bar -->
    <top>
        <VBox style="-fx-background-color: #4CAF50; -fx-padding: 15;">
            <Label text="Customer Dashboard"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Center: Main Content Area -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Text Area for displaying information -->
            <Label text="Account Information:"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TextArea fx:id="txtArea"
                      editable="false"
                      VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
        </VBox>
    </center>

    <!-- Right: Action Buttons -->
    <right>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Actions:"
                   style="-fx-font-weight: bold;"/>

            <Button text="View Accounts"
                    onAction="#listAccounts"
                    prefWidth="150"
                    style="-fx-font-size: 12px;"/>

            <Button text="Open New Account"
                    onAction="#openNewAccount"
                    prefWidth="150"
                    style="-fx-font-size: 12px; -fx-background-color: #9C27B0; -fx-text-fill: white;"/>

            <Separator/>

            <Button text="Deposit"
                    onAction="#deposit"
                    prefWidth="150"
                    style="-fx-font-size: 12px; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>

            <Button text="Withdraw"
                    onAction="#withdraw"
                    prefWidth="150"
                    style="-fx-font-size: 12px; -fx-background-color: #FF9800; -fx-text-fill: white;"/>

            <Separator/>

            <Button text="Logout"
                    onAction="#logout"
                    prefWidth="150"
                    style="-fx-font-size: 12px; -fx-background-color: #f44336; -fx-text-fill: white;"/>
        </VBox>
    </right>

</BorderPane>
