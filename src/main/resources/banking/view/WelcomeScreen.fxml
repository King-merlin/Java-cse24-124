<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="banking.controller.WelcomeController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #f0f0f0;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="Welcome to Student Banking System">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <Separator prefWidth="300"/>

    <VBox spacing="15" alignment="CENTER">
        <Button text="Customer Login"
                onAction="#handleCustomerLogin"
                prefWidth="200"
                prefHeight="40"
                style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>

        <Button text="Admin Login"
                onAction="#handleAdminLogin"
                prefWidth="200"
                prefHeight="40"
                style="-fx-font-size: 14px; -fx-background-color: #2196F3; -fx-text-fill: white;"/>

        <Button text="Open New Account"
                onAction="#handleOpenAccount"
                prefWidth="200"
                prefHeight="40"
                style="-fx-font-size: 14px; -fx-background-color: #FF9800; -fx-text-fill: white;"/>
    </VBox>

    <Label text="Please select an option above"
           style="-fx-text-fill: #666666; -fx-font-style: italic;">
        <font>
            <Font size="12"/>
        </font>
    </Label>

</VBox>
</BorderPane>