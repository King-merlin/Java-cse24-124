<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.controller.AdminDashboardController"
            prefHeight="700.0" prefWidth="900.0">

    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <Label text="Admin Dashboard" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
            <Label text="Manage the banking system" textFill="WHITE" style="-fx-font-size: 14px;">
                <VBox.margin>
                    <Insets top="5.0"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <center>
        <TextArea fx:id="txtArea" editable="false" wrapText="true"
                  style="-fx-font-family: 'Courier New'; -fx-font-size: 13px; -fx-control-inner-background: #fafafa;">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </BorderPane.margin>
        </TextArea>
    </center>

    <bottom>
        <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #f5f5f5;">
            <!-- First Row of Buttons -->
            <HBox spacing="10.0" alignment="CENTER">
                <Button text="List All Customers" onAction="#listAllCustomers"
                        prefWidth="160.0" prefHeight="40.0"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>

                <Button text="Apply Interest" onAction="#applyInterest"
                        prefWidth="160.0" prefHeight="40.0"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>

                <Button text="Add Admin Account" onAction="#createAdminAccount"
                        prefWidth="160.0" prefHeight="40.0"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>

                <Button text="Logout" onAction="#logout"
                        prefWidth="160.0" prefHeight="40.0"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>